<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ListPreference
        android:key="pref_logging_profile"
        android:title="Logging Profile"
        android:summary="Click to select logging profile"
        android:entries="@array/log_profile_name"
        android:entryValues="@array/log_profile_value"
        android:dialogTitle="Select logging profile" />
    <CheckBoxPreference
        android:key="pref_meas_start_voltage"
        android:title="Log starting voltage"
        android:summary="Capture battery voltage during start" />
</PreferenceScreen>
