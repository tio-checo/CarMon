<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:keepScreenOn = "true"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical" >

    <Button
        android:id="@+id/loggerStartButton"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:enabled="true"
        android:text="@string/loggerStartButtonText"
        android:textSize="30dp"
        android:onClick="launchObdLogger" />

    <Button
        android:id="@+id/diagStartButton"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:enabled="false"
        android:text="@string/diagStartButtonText"
        android:textSize="30dp" />

    <Button
        android:id="@+id/scopeStartButton"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:enabled="false"
        android:text="@string/scopeStartButtonText"
        android:textSize="30dp" />

    <Button
        android:id="@+id/viewerStartButton"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:enabled="false"
        android:text="@string/viewerStartButtonText"
        android:textSize="30dp" />

</LinearLayout>

