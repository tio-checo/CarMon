<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:keepScreenOn = "true"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical" >

    <Button
        android:id="@+id/LoggerStartButton"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:enabled="true"
        android:text="@string/LoggerStartButton"
        android:textSize="30dp"
        android:onClick="launchObdLogger" />

    <Button
        android:id="@+id/DiagStartButton"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:enabled="false"
        android:text="@string/DiagStartButton"
        android:textSize="30dp" />

    <Button
        android:id="@+id/ScopeStartButton"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:enabled="false"
        android:text="@string/ScopeStartButton"
        android:textSize="30dp" />

    <Button
        android:id="@+id/ViewerStartButton"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:enabled="false"
        android:text="@string/ViewerStartButton"
        android:textSize="30dp" />

</LinearLayout>

